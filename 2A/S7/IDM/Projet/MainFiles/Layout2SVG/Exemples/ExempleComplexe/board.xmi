<?xml version="1.0" encoding="UTF-8"?>
<layout:Layout
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:layout="http://www.example.org/layout"
    nom="Filter_PCB_Layout">
  <boards nom="Main_PCB"
      largeur="100.0"
      hauteur="60.0">
    <couches
        xsi:type="layout:CoucheExterne"
        nom="Top_Layer"
        numero="1">
      <pistes
          nom="Track_V_Unreg"
          largeur="1.0">
        <points
            x="5.0"
            y="5.0"/>
        <points
            x="40.0"
            y="10.0"/>
        <points
            x="60.0"
            y="10.0"/>
        <points
            x="75.0"
            y="10.0"/>
        <connexion
            href="filter.xmi#//@connexions.0"/>
      </pistes>
      <pistes
          nom="Track_GND_Main"
          largeur="1.0">
        <points
            x="5.0"
            y="5.0"/>
        <points
            x="50.0"
            y="50.0"/>
        <points
            x="60.0"
            y="25.0"/>
        <points
            x="75.0"
            y="25.0"/>
        <connexion
            href="filter.xmi#//@connexions.2"/>
      </pistes>
      <pistes
          nom="Track_Signal"
          largeur="1.0">
        <points
            x="60.0"
            y="10.0"/>
        <points
            x="60.0"
            y="25.0"/>
        <points
            x="50.0"
            y="40.0"/>
        <connexion
            href="filter.xmi#//@connexions.1"/>
      </pistes>
      <composants
          x="5.0"
          y="5.0">
        <instance
            href="filter.xmi#//@instances.0"/>
      </composants>
      <composants
          x="40.0"
          y="10.0"
          rotation="90.0">
        <instance
            href="filter.xmi#//@instances.1"/>
      </composants>
      <composants
          x="60.0"
          y="10.0">
        <instance
            href="filter.xmi#//@instances.2"/>
      </composants>
      <composants
          x="75.0"
          y="10.0">
        <instance
            href="filter.xmi#//@instances.3"/>
      </composants>
      <composants
          x="60.0"
          y="25.0">
        <instance
            href="filter.xmi#//@instances.4"/>
      </composants>
      <composants
          x="75.0"
          y="25.0">
        <instance
            href="filter.xmi#//@instances.5"/>
      </composants>
      <composants
          x="50.0"
          y="40.0">
        <instance
            href="filter.xmi#//@instances.6"/>
      </composants>
      <composants
          x="50.0"
          y="50.0">
        <instance
            href="filter.xmi#//@instances.7"/>
      </composants>
    </couches>
    <couches
        xsi:type="layout:CoucheExterne"
        nom="Bottom_Layer"
        numero="2">
      <pistes
          nom="Track_GND_Return"
          largeur="3.0">
        <points
            x="60.0"
            y="10.0"/>
        <points
            x="60.0"
            y="25.0"/>
        <points
            x="75.0"
            y="25.0"/>
        <connexion
            href="filter.xmi#//@connexions.2"/>
      </pistes>
    </couches>
  </boards>
  <circuit href="filter.xmi#/"/>
</layout:Layout>