<?xml version="1.0" encoding="UTF-8"?>
<description:Group xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:description="http://www.eclipse.org/sirius/description/1.1.0" xmlns:description_1="http://www.eclipse.org/sirius/diagram/description/1.1.0" xmlns:style="http://www.eclipse.org/sirius/diagram/description/style/1.1.0" xmlns:tool="http://www.eclipse.org/sirius/description/tool/1.1.0" xmlns:tool_1="http://www.eclipse.org/sirius/diagram/description/tool/1.1.0" name="layout" version="12.0.0.2017041100">
  
  <metamodelDeclarations xsi:type="description:MetamodelReference">
    <metamodel href="http://www.example.org/layout#/"/>
  </metamodelDeclarations>

  <ownedViewpoints name="LayoutViewpoint" modelFileExtension="layout">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="LayoutDiagram" titleExpression="aql:'Layout - ' + self.nom" domainClass="layout.Layout" enablePopupBars="true">
      <defaultLayer name="Default">
        
        <containerMappings name="BoardContainer" semanticCandidatesExpression="feature:boards" domainClass="layout.Board" labelDirectEdit="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='EditBoardName']">
          <style xsi:type="style:FlatContainerStyleDescription" borderSizeComputationExpression="2" labelExpression="aql:self.nom + ' (' + self.largeur.toString() + 'x' + self.hauteur.toString() + ' mm)'">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_blue']"/>
            <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
          </style>
          
          <subContainerMappings name="CoucheContainer" semanticCandidatesExpression="feature:couches" domainClass="layout.Couche">
            <style xsi:type="style:FlatContainerStyleDescription" borderSizeComputationExpression="1" labelExpression="aql:self.nom + ' (Couche ' + self.numero.toString() + ')'">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_gray']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
              <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
            </style>
             
            <conditionnalStyles predicateExpression="aql:self.oclIsKindOf(layout::CoucheExterne)">
              <style xsi:type="style:FlatContainerStyleDescription" borderSizeComputationExpression="1" labelExpression="aql:self.nom + ' (Externe - Couche ' + self.numero.toString() + ')'">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_green']"/>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_green']"/>
                <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
              </style>
            </conditionnalStyles>
            
            <conditionnalStyles predicateExpression="aql:self.oclIsKindOf(layout::CoucheInterne)">
              <style xsi:type="style:FlatContainerStyleDescription" borderSizeComputationExpression="1" labelExpression="aql:self.nom + ' (Interne - Couche ' + self.numero.toString() + ')'">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='gray']"/>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <backgroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
                <foregroundColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='white']"/>
              </style>
            </conditionnalStyles>
            
            <subNodeMappings name="ComposantNode" preconditionExpression="aql:container.oclIsKindOf(layout::CoucheExterne)" semanticCandidatesExpression="aql:if self.oclIsKindOf(layout::CoucheExterne) then self.oclAsType(layout::CoucheExterne).composants else Sequence{} endif" domainClass="layout.ComposantPosition" labelDirectEdit="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@toolSections.0/@ownedTools[name='EditComposantPosition']">
              <style xsi:type="style:SquareDescription" labelExpression="aql:if self.instance.nom.oclIsUndefined() then 'Composant' else self.instance.nom endif" tooltipExpression="aql:'Position: (' + self.x.toString() + ', ' + self.y.toString() + ') - Rotation: ' + self.rotation.toString() + '°'" sizeComputationExpression="8">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_orange']"/>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='orange']"/>
              </style>
            </subNodeMappings>
            
            <subNodeMappings name="PisteNode" domainClass="layout.Piste" semanticCandidatesExpression="feature:pistes">
              <style xsi:type="style:SquareDescription" labelExpression="aql:self.nom" sizeComputationExpression="2" resizeKind="NSEW">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='dark_red']"/>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
              </style>
            </subNodeMappings>
            
          </subContainerMappings>
        </containerMappings>
        
        <edgeMappings name="PisteEdgeMapping" semanticCandidatesExpression="aql:self.boards.couches.pistes" sourceMapping="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@containerMappings[name='BoardContainer']/@subContainerMappings[name='CoucheContainer']/@subNodeMappings[name='ComposantNode']" targetMapping="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@containerMappings[name='BoardContainer']/@subContainerMappings[name='CoucheContainer']/@subNodeMappings[name='ComposantNode']" targetFinderExpression="service:getComposantCible(self)" sourceFinderExpression="service:getComposantSource(self)" domainClass="layout.Piste" useDomainElement="true" reconnections="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@toolSections.1/@ownedTools[name='ReconnectPiste']">
          <style sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='red']"/>
            <centerLabelStyleDescription labelExpression="aql:self.nom + ' (' + self.largeur.toString() + ' mm)'">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        
        <toolSections name="CreationTools">
          
          <ownedTools xsi:type="tool_1:ContainerCreationDescription" name="CreateBoard" label="Board" containerMappings="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@containerMappings[name='BoardContainer']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool:CreateInstance" typeName="layout.Board" referenceName="boards" variableName="instance">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nom" valueExpression="aql:'Board_' + container.boards->size().toString()"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="largeur" valueExpression="100.0"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="hauteur" valueExpression="80.0"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          
          <ownedTools xsi:type="tool_1:ContainerCreationDescription" name="CreateCoucheExterne" label="Couche Externe" containerMappings="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@containerMappings[name='BoardContainer']/@subContainerMappings[name='CoucheContainer']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool:CreateInstance" typeName="layout.CoucheExterne" referenceName="couches" variableName="instance">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nom" valueExpression="aql:'Couche_Externe_' + (container.couches->size() + 1).toString()"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="numero" valueExpression="aql:container.couches->size() + 1"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          
          <ownedTools xsi:type="tool_1:ContainerCreationDescription" name="CreateCoucheInterne" label="Couche Interne" containerMappings="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@containerMappings[name='BoardContainer']/@subContainerMappings[name='CoucheContainer']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool:CreateInstance" typeName="layout.CoucheInterne" referenceName="couches" variableName="instance">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nom" valueExpression="aql:'Couche_Interne_' + (container.couches->size() + 1).toString()"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="numero" valueExpression="aql:container.couches->size() + 1"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          
          <ownedTools xsi:type="tool_1:NodeCreationDescription" name="CreateComposantPosition" label="Placer Composant Netlist" precondition="aql:container.oclIsKindOf(layout::CoucheExterne)" nodeMappings="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@containerMappings[name='BoardContainer']/@subContainerMappings[name='CoucheContainer']/@subNodeMappings[name='ComposantNode']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:container">
                <subModelOperations xsi:type="tool:CreateInstance" typeName="layout.ComposantPosition" referenceName="composants" variableName="instance">
                  <subModelOperations xsi:type="tool:SetValue" featureName="x" valueExpression="0.0"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="y" valueExpression="0.0"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="rotation" valueExpression="0.0"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="instance" valueExpression="service:selectionnerInstanceNetlist(container)"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          
          <ownedTools xsi:type="tool_1:ContainerCreationDescription" name="CreatePiste" label="Piste (Détail)" containerMappings="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@containerMappings[name='BoardContainer']/@subContainerMappings[name='CoucheContainer']">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool:CreateInstance" typeName="layout.Piste" referenceName="pistes" variableName="piste">
                  <subModelOperations xsi:type="tool:SetValue" featureName="nom" valueExpression="aql:'Piste_' + (container.pistes->size() + 1).toString()"/>
                  <subModelOperations xsi:type="tool:SetValue" featureName="largeur" valueExpression="1.0"/>
                  <subModelOperations xsi:type="tool:CreateInstance" typeName="layout.Point" referenceName="points" variableName="point1">
                    <subModelOperations xsi:type="tool:SetValue" featureName="x" valueExpression="0.0"/>
                    <subModelOperations xsi:type="tool:SetValue" featureName="y" valueExpression="0.0"/>
                  </subModelOperations>
                  <subModelOperations xsi:type="tool:CreateInstance" typeName="layout.Point" referenceName="points" variableName="point2">
                    <subModelOperations xsi:type="tool:SetValue" featureName="x" valueExpression="10.0"/>
                    <subModelOperations xsi:type="tool:SetValue" featureName="y" valueExpression="10.0"/>
                  </subModelOperations>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          
          <ownedTools xsi:type="tool_1:DirectEditLabel" name="EditBoardName">
            <mask mask="{0}"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:SetValue" featureName="nom" valueExpression="var:arg0"/>
            </initialOperation>
          </ownedTools>
          
          <ownedTools xsi:type="tool_1:DirectEditLabel" name="EditComposantPosition">
            <mask mask="{0}"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:self.instance">
                <subModelOperations xsi:type="tool:SetValue" featureName="nom" valueExpression="var:arg0"/>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          
          <ownedTools xsi:type="tool_1:DeleteElementDescription" name="DeleteElement">
            <element name="element"/>
            <elementView name="elementView"/>
            <containerView name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:RemoveElement"/>
            </initialOperation>
          </ownedTools>
        </toolSections>
        
        <toolSections name="EdgeTools">
          <ownedTools xsi:type="tool_1:EdgeCreationDescription" name="CreatePisteEdge" label="Lier par Piste" edgeMappings="//@ownedViewpoints[name='LayoutViewpoint']/@ownedRepresentations[name='LayoutDiagram']/@defaultLayer/@edgeMappings[name='PisteEdgeMapping']">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:source.eContainer().eContainer()">
                <subModelOperations xsi:type="tool:ChangeContext" browseExpression="aql:source.eContainer()">
                  <subModelOperations xsi:type="tool:CreateInstance" typeName="layout.Piste" referenceName="pistes" variableName="newPiste">
                    <subModelOperations xsi:type="tool:SetValue" featureName="nom" valueExpression="aql:'Piste_' + source.instance.nom + '_to_' + target.instance.nom"/>
                    <subModelOperations xsi:type="tool:SetValue" featureName="largeur" valueExpression="1.0"/>
                  </subModelOperations>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          
          <ownedTools xsi:type="tool_1:ReconnectEdgeDescription" name="ReconnectPiste">
            <source name="source"/>
            <target name="target"/>
            <sourceView name="sourceView"/>
            <targetView name="targetView"/>
            <element name="element"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool:ChangeContext" browseExpression="var:element"/>
            </initialOperation>
          </ownedTools>
        </toolSections>
        
      </defaultLayer>
    </ownedRepresentations>
    <ownedJavaExtensions qualifiedClassName="fr.n7.layout.design.Services"/>
  </ownedViewpoints>
</description:Group>