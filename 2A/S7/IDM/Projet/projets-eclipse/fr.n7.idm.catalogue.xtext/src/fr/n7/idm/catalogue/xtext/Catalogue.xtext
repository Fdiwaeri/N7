grammar fr.n7.idm.catalogue.xtext.Catalogue with org.eclipse.xtext.common.Terminals

// On importe votre paquet Ecore existant
import "platform:/resource/fr.n7.idm.catalogue/model/catalogue.ecore"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

Catalogue returns Catalogue:
    'catalogue' '{'
        composants+=Composant*
    '}';

Composant returns Composant:
    'composant' nom=EString '{'
        ('fabricant' fabricant=EString)?
        ('description' description=EString)?
        (ports+=Port)*
        (empreinte=Empreinte)?
        (contraintes+=Contrainte)*
    '}';

Port returns Port:
    'port' nom=EString 'type' type=EString;

Empreinte returns Empreinte:
    'empreinte' '{'
        'largeur' largeur=EDouble
        'hauteur' hauteur=EDouble
        (positionsPort+=PositionPort)*
    '}';

PositionPort returns PositionPort:
    'position' 'pour' port=[Port|EString] ':' 'x' x=EDouble 'y' y=EDouble;

// --- Gestion du Polymorphisme des Contraintes ---

Contrainte returns Contrainte:
    ContrainteEt | ContrainteOu | ContrainteNon | ContrainteGeometrique | ContrainteRedondance;

ContrainteGeometrique returns ContrainteGeometrique:
    'geo' '{'
        'min' distanceMin=EDouble
        'max' distanceMax=EDouble
        ('interdit' zoneInterdite=EString)?
    '}';

ContrainteRedondance returns ContrainteRedondance:
    'redondance' '{' 'min' nombreMinimum=EInt '}';

ContrainteEt returns ContrainteEt:
    'AND' '(' operands+=Contrainte (',' operands+=Contrainte)+ ')';

ContrainteOu returns ContrainteOu:
    'OR' '(' operands+=Contrainte (',' operands+=Contrainte)+ ')';

ContrainteNon returns ContrainteNon:
    'NOT' '(' operand=Contrainte ')';

// --- Types de base ---

EString returns ecore::EString:
    STRING | ID;

EDouble returns ecore::EDouble:
    '-'? INT? '.' INT (('E'|'e') '-'? INT)?;

EInt returns ecore::EInt:
    '-'? INT;