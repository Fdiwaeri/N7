 fr.n7.idm.catalogue;visibility:=reexport,
 org.eclipse.core.runtime,
 fr.n7.idm.netlist;bundle-version="0.1.0";visibility:=reexport,
 org.eclipse.emf.ecore.xmi;bundle-version="2.35.0"
Bundle-ActivationPolicy: lazy
